{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pasalo",
  "version": "1.0.9",
  "identifier": "com.neomambi.pasalo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pasalo",
        "width": 920,
        "height": 640,
        "minWidth": 640,
        "minHeight": 460,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "https"
          ],
          "host": "pasalo-server.vercel.app",
          "path": [
            "/"
          ],
          "appLink": true
        },
        {
          "scheme": [
            "pasalo"
          ],
          "host": "add",
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "pasalo"
        ]
      }
    }
  }
}
